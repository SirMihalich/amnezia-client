+cmake_minimum_required(VERSION 3.21)
+project(AmneziaRouteCapturePolicyTests LANGUAGES CXX)
+
+if(NOT WIN32)
+  message(FATAL_ERROR "These tests use Windows IP Helper API and must run on Windows.")
+endif()
+
+set(CMAKE_CXX_STANDARD 17)
+set(CMAKE_CXX_STANDARD_REQUIRED ON)
+find_package(Qt6 REQUIRED COMPONENTS Core)
+
+enable_testing()
+add_executable(routecapturepolicy_test routecapturepolicy_test.cpp)
+target_link_libraries(routecapturepolicy_test PRIVATE Qt6::Core iphlpapi ws2_32)
+add_test(NAME routecapturepolicy_test COMMAND routecapturepolicy_test)
diff --git a/tests/windows-route-capture-policy/routecapturepolicy_test.cpp b/tests/windows-route-capture-policy/routecapturepolicy_test.cpp
new file mode 100644
index 0000000..9c03de0
--- /dev/null
+++ b/tests/windows-route-capture-policy/routecapturepolicy_test.cpp
@@ -0,0 +1,142 @@
+/* Windows-only regression tests for windowsroutecapturepolicy.h.
+ * Build with CMake and run with CTest on Windows. */
+#include <winsock2.h>
+#include <ws2tcpip.h>
+#include <windows.h>
+#include <iphlpapi.h>
+
+#include <cassert>
+#include <cstring>
+#include <iostream>
+#include <memory>
+#include <vector>
+
+#include "../../client/platforms/windows/daemon/windowsroutecapturepolicy.h"
+
+namespace {
+constexpr ULONG64 kPhysicalLuid = 19;
+constexpr ULONG64 kOtherLuid = 27;
+constexpr ULONG64 kVpnLuid = 54;
+
+void setV4(SOCKADDR_INET* address, const char* text) {
+  std::memset(address, 0, sizeof(*address));
+  address->Ipv4.sin_family = AF_INET;
+  assert(InetPtonA(AF_INET, text, &address->Ipv4.sin_addr) == 1);
+}
+
+void setV6(SOCKADDR_INET* address, const char* text) {
+  std::memset(address, 0, sizeof(*address));
+  address->Ipv6.sin6_family = AF_INET6;
+  assert(InetPtonA(AF_INET6, text, &address->Ipv6.sin6_addr) == 1);
+}
+
+void setV4Prefix(IP_ADDRESS_PREFIX* prefix, const char* text, UCHAR length) {
+  std::memset(prefix, 0, sizeof(*prefix));
+  prefix->Prefix.Ipv4.sin_family = AF_INET;
+  assert(InetPtonA(AF_INET, text, &prefix->Prefix.Ipv4.sin_addr) == 1);
+  prefix->PrefixLength = length;
+}
+
+void setV6Prefix(IP_ADDRESS_PREFIX* prefix, const char* text, UCHAR length) {
+  std::memset(prefix, 0, sizeof(*prefix));
+  prefix->Prefix.Ipv6.sin6_family = AF_INET6;
+  assert(InetPtonA(AF_INET6, text, &prefix->Prefix.Ipv6.sin6_addr) == 1);
+  prefix->PrefixLength = length;
+}
+
+void setConnectedV4(MIB_IPFORWARD_ROW2* row, ULONG64 luid,
+                    const char* network, UCHAR length) {
+  InitializeIpForwardEntry(row);
+  row->InterfaceLuid.Value = luid;
+  setV4Prefix(&row->DestinationPrefix, network, length);
+  row->NextHop.si_family = AF_INET;
+  row->NextHop.Ipv4.sin_addr.s_addr = INADDR_ANY;
+  row->Protocol = MIB_IPPROTO_LOCAL;
+}
+
+void setStaticV4(MIB_IPFORWARD_ROW2* row, ULONG64 luid,
+                 const char* destination, UCHAR length, const char* gateway) {
+  InitializeIpForwardEntry(row);
+  row->InterfaceLuid.Value = luid;
+  setV4Prefix(&row->DestinationPrefix, destination, length);
+  setV4(&row->NextHop, gateway);
+  row->Protocol = MIB_IPPROTO_NETMGMT;
+}
+
+void setConnectedV6(MIB_IPFORWARD_ROW2* row, ULONG64 luid,
+                    const char* network, UCHAR length) {
+  InitializeIpForwardEntry(row);
+  row->InterfaceLuid.Value = luid;
+  setV6Prefix(&row->DestinationPrefix, network, length);
+  row->NextHop.si_family = AF_INET6;
+  IN6_ADDR zero{};
+  row->NextHop.Ipv6.sin6_addr = zero;
+  row->Protocol = MIB_IPPROTO_LOCAL;
+}
+
+void setStaticV6(MIB_IPFORWARD_ROW2* row, ULONG64 luid,
+                 const char* destination, UCHAR length, const char* gateway) {
+  InitializeIpForwardEntry(row);
+  row->InterfaceLuid.Value = luid;
+  setV6Prefix(&row->DestinationPrefix, destination, length);
+  setV6(&row->NextHop, gateway);
+  row->Protocol = MIB_IPPROTO_NETMGMT;
+}
+
+struct RouteTable2Rows {
+  std::vector<unsigned char> storage;
+  PMIB_IPFORWARD_TABLE2 table;
+  explicit RouteTable2Rows(size_t count)
+      : storage(sizeof(MIB_IPFORWARD_TABLE2) +
+                (count - 1) * sizeof(MIB_IPFORWARD_ROW2)),
+        table(reinterpret_cast<PMIB_IPFORWARD_TABLE2>(storage.data())) {
+    std::memset(storage.data(), 0, storage.size());
+    table->NumEntries = static_cast<ULONG>(count);
+  }
+};
+
+void testIpv4StaticRouteViaConnectedPhysicalGatewayIsDetected() {
+  RouteTable2Rows routes(2);
+  setConnectedV4(&routes.table->Table[0], kPhysicalLuid, "192.168.10.0", 24);
+  setStaticV4(&routes.table->Table[1], kPhysicalLuid, "192.168.99.0", 24,
+              "192.168.10.1");
+  assert(WindowsRouteCapturePolicy::hasConnectedPhysicalGateway(
+      &routes.table->Table[1], routes.table, kVpnLuid));
+}
+
+void testUnrelatedGatewayIsNotMatched() {
+  RouteTable2Rows routes(2);
+  setConnectedV4(&routes.table->Table[0], kPhysicalLuid, "192.168.10.0", 24);
+  setStaticV4(&routes.table->Table[1], kPhysicalLuid, "172.20.0.0", 16,
+              "172.16.0.1");
+  assert(!WindowsRouteCapturePolicy::hasConnectedPhysicalGateway(
+      &routes.table->Table[1], routes.table, kVpnLuid));
+}
+
+void testIpv6StaticRouteViaConnectedPhysicalGatewayIsDetected() {
+  RouteTable2Rows routes(2);
+  setConnectedV6(&routes.table->Table[0], kPhysicalLuid, "fd00:1::", 64);
+  setStaticV6(&routes.table->Table[1], kPhysicalLuid, "fd00:99::", 64,
+              "fd00:1::1");
+  assert(WindowsRouteCapturePolicy::hasConnectedPhysicalGateway(
+      &routes.table->Table[1], routes.table, kVpnLuid));
+}
+
+void testConnectedPrefixOnDifferentInterfaceDoesNotMatch() {
+  RouteTable2Rows routes(2);
+  setConnectedV4(&routes.table->Table[0], kOtherLuid, "192.168.10.0", 24);
+  setStaticV4(&routes.table->Table[1], kPhysicalLuid, "192.168.99.0", 24,
+              "192.168.10.1");
+  assert(!WindowsRouteCapturePolicy::hasConnectedPhysicalGateway(
+      &routes.table->Table[1], routes.table, kVpnLuid));
+}
+}  // namespace
+
+int main() {
+  testIpv4StaticRouteViaConnectedPhysicalGatewayIsDetected();
+  testUnrelatedGatewayIsNotMatched();
+  testIpv6StaticRouteViaConnectedPhysicalGatewayIsDetected();
+  testConnectedPrefixOnDifferentInterfaceDoesNotMatch();
+  std::cout << "All route-capture policy tests passed.\n";
+  return 0;
+}
